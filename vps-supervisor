# --------------------------------------------------------------------------

APP_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")
DOMAIN_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$")
ENV_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
SPEC_KEYS = ("app", "runtime", "host", "domain", "build", "image", "port", "healthcheck", "env", "volumes", "proxy")


def _strip_comment(line):
    quote = None
    for i, ch in enumerate(line):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "#" and (i == 0 or line[i - 1].isspace()):
            return line[:i].rstrip()
    return line.rstrip()


def _scalar(s):
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
        return s[1:-1]
    if s.startswith("[") and s.endswith("]"):
        return [_scalar(x) for x in s[1:-1].split(",") if x.strip()]
    if s == "{}":
        return {}
    low = s.lower()
    if low in ("true", "yes"):
        return True
    if low in ("false", "no"):
        return False
    if low in ("null", "~", ""):
        return None
    if re.match(r"^-?\d+$", s):
        return int(s)
    return s


def mini_yaml(text):
    """Tiny YAML subset: nested maps, lists of scalars, scalars, comments."""
    lines = []
    for raw in text.splitlines():
        if raw.strip() in ("---", "..."):
            continue
        s = _strip_comment(raw)
        if s.strip():
            lines.append((len(s) - len(s.lstrip()), s.strip()))

    def block(i, ind):
        if lines[i][1].startswith("- ") or lines[i][1] == "-":
            out = []
            while i < len(lines) and lines[i][0] == ind and (lines[i][1].startswith("- ") or lines[i][1] == "-"):
                item = lines[i][1][1:].strip()
                i += 1
                if item:
                    out.append(_scalar(item))
                elif i < len(lines) and lines[i][0] > ind:
                    v, i = block(i, lines[i][0])
                    out.append(v)
                else:
                    out.append(None)
            return out, i
        out = {}
        while i < len(lines) and lines[i][0] == ind:
            m = re.match(r"^(\"[^\"]*\"|'[^']*'|[^:]+?)\s*:(?:\s+(.*))?$", lines[i][1])
            if not m:
                raise ValueError("cannot parse line: %r" % lines[i][1])
            key, rest = _scalar(m.group(1)), m.group(2)
            i += 1
            if rest is not None and rest != "":
                out[key] = _scalar(rest)
            elif i < len(lines) and (lines[i][0] > ind or
                                     (lines[i][0] == ind and lines[i][1].startswith("- "))):
                out[key], i = block(i, lines[i][0])
            else:
                out[key] = None
        return out, i

    if not lines:
        return {}
    value, i = block(0, lines[0][0])
    if i != len(lines):
        raise ValueError("unexpected indentation at: %r" % lines[i][1])
    return value


def load_yaml(path):
    with open(path) as f:
        text = f.read()
    try:
        import yaml
    except ImportError:
        return mini_yaml(text)
    return yaml.safe_load(text)


def load_spec(path):
    try:
        raw = load_yaml(path)
    except OSError as e:
        die("cannot read %s: %s" % (path, e))
    except Exception as e:  # yaml.YAMLError, ValueError
        die("cannot parse %s: %s" % (path, e))
    if not isinstance(raw, dict):
        die("%s: expected a mapping at top level" % path)

    errors = []
    unknown = sorted(set(raw) - set(SPEC_KEYS))
    if unknown:
        errors.append("unknown keys: %s (allowed: %s)" % (", ".join(map(str, unknown)), ", ".join(SPEC_KEYS)))

    app = raw.get("app")
    if not isinstance(app, str) or not APP_RE.match(app):
        errors.append("app: required, lowercase letters/digits/dashes (got %r)" % app)

    runtime = raw.get("runtime", "docker")
    if runtime not in RUNTIMES:
        errors.append("runtime: one of %s (got %r)" % (", ".join(RUNTIMES), runtime))
    elif runtime != "docker":
        errors.append("runtime: `%s` (app run directly on the machine) is planned but not implemented yet"
                      % runtime)

    host = raw.get("host")
    if isinstance(host, str):
        host = {"ssh": host}
    if not isinstance(host, dict) or not isinstance(host.get("ssh"), str) or not host["ssh"]:
        errors.append("host: required, e.g. `host: root@1.2.3.4` or `host: {ssh: ..., port: 22}`")
        host = {}

    domain = raw.get("domain")
    if domain is not None:
        domain = str(domain).lower().rstrip(".")
        if not DOMAIN_RE.match(domain):
            errors.append("domain: invalid hostname %r" % domain)

    build, image = raw.get("build"), raw.get("image")
    if (build is None) == (image is None):
        errors.append("exactly one of `build` (local Dockerfile dir) or `image` (registry image) is required")
    if isinstance(build, str):
        build = {"context": build}
    if build is not None:
        if not isinstance(build, dict):
            errors.append("build: expected a path or {context, dockerfile}")
            build = None
        else:
            here = os.path.dirname(os.path.abspath(path))
            ctx = os.path.normpath(os.path.join(here, os.path.expanduser(str(build.get("context", ".")))))
            dockerfile = str(build.get("dockerfile", "Dockerfile"))
            if not os.path.isfile(os.path.join(ctx, dockerfile)):
                errors.append("build: %s not found in %s" % (dockerfile, ctx))
            build = {"context": ctx, "dockerfile": dockerfile}
    if image is not None and not isinstance(image, str):
        errors.append("image: expected a string")

    port = raw.get("port")
    if not isinstance(port, int) or not 0 < port < 65536:
        errors.append("port: required, the port the app listens on inside the container")

    health = raw.get("healthcheck", "/")
    if not isinstance(health, str) or not health.startswith("/"):
        errors.append("healthcheck: expected a path starting with /")

    env = raw.get("env") or {}
    if not isinstance(env, dict):
        errors.append("env: expected a mapping")
        env = {}
    env = {str(k): ("" if v is None else str(v).lower() if isinstance(v, bool) else str(v))
           for k, v in env.items()}
    for k, v in env.items():
        if not ENV_RE.match(k):
            errors.append("env: invalid variable name %r" % k)
        if "\n" in v:
            errors.append("env: %s must be a single line" % k)

    volumes = raw.get("volumes") or []
    if not isinstance(volumes, list) or not all(isinstance(v, str) and ":" in v for v in volumes):
        errors.append("volumes: expected a list of `source:target[:ro]`")
        volumes = []

    proxy = raw.get("proxy") or {}
    if not isinstance(proxy, dict):
        errors.append("proxy: expected a mapping of overrides")
        proxy = {}

    if errors:
        die("invalid deployment file %s:\n  - %s" % (path, "\n  - ".join(errors)))
    return {"app": app, "runtime": runtime, "host": host, "domain": domain, "build": build, "image": image, "port": port,
            "healthcheck": health, "env": env, "volumes": volumes, "proxy": proxy}


def resolve_proxy(cfg, spec):
    """Merge detected proxy params with overrides; check the mode is deployable."""
    proxy = dict(cfg.get("proxy") or {})
    params = dict(proxy.get("params") or {})
    overrides = spec["proxy"]
    if "mode" in overrides:
        proxy["mode"] = overrides["mode"]
    for k in ("network", "entrypoint", "http_entrypoint", "certresolver"):
        if k in overrides:
            params[k] = overrides[k]
    proxy["params"] = params
    mode = proxy.get("mode")
    if mode not in DEPLOYABLE_MODES:
        die("proxy mode `%s` (%s) is classified but not deployable yet; supported: %s"
            % (mode, proxy.get("reason"), ", ".join(DEPLOYABLE_MODES)))
    if mode == "traefik-docker":
        missing = [k for k in ("network", "entrypoint") if not params.get(k)]
        if missing:
            die("traefik detected but %s could not be read from its config; set them under `proxy:` "
                "in the deployment file" % " and ".join(missing))
        if not spec["domain"]:
            die("`domain` is required with proxy mode traefik-docker")
    return proxy


def check_dns(domain, host_ips):
    found = set()
    for family in (socket.AF_INET, socket.AF_INET6):
        try:
            for ai in socket.getaddrinfo(domain, None, family, socket.SOCK_STREAM):
                ip = norm_ip(ai[4][0])
                if ip:
                    found.add(ip)
        except socket.gaierror:
            pass
    v4 = sorted(ip for ip in host_ips if ":" not in ip)
    if not found:
        return found, ["%s does not resolve: create a DNS A record %s -> %s"
                       % (domain, domain, v4[0] if v4 else "<host ip>")]
    wrong = sorted(found - host_ips)
    if wrong:
        return found, ["%s resolves to %s, which is not this host (%s)"
                       % (domain, ", ".join(wrong), ", ".join(sorted(host_ips)))]
    return found, []


def pack_context(ctx):
    def keep(ti):
        if os.path.basename(ti.name) in (".git", "__pycache__"):
            return None
        ti.uid = ti.gid = 0
        ti.uname = ti.gname = ""
        return ti
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as t:
        t.add(ctx, arcname=".", filter=keep)
    return buf.getvalue()


def verify_https(url, timeout=120):
    deadline = time.time() + timeout
    last = None
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=10) as r:
                return True, "%s -> %d" % (url, r.status)
        except urllib.error.HTTPError as e:
            if e.code < 500:
                return True, "%s -> %d" % (url, e.code)
            last = "HTTP %d" % e.code
        except Exception as e:  # TLS not ready yet, DNS caches, ...
            last = str(getattr(e, "reason", e))
        time.sleep(5)
    return False, "%s: %s" % (url, last)


