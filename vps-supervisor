def cmd_install(args):
    print("==> probing %s" % args.target)
    facts = ensure_python(args)
    print("    user %s, %s %s, python %s, docker %s" % (
        facts.get("user"), facts.get("os", "?"), facts.get("arch", "?"),
        facts.get("python_version"), "yes" if facts.get("docker") else "no"))
    print("==> installing agent")
    base, cfg = ensure_agent(args, facts)
    print_summary(cfg)
    print("==> vps-supervisor %s ready on %s (%s)" % (VERSION, args.target, base))


def locate_agent(args):
    facts = probe(args)
    if "python3" not in facts:
        die("python3 not found on %s" % args.target)
    args.python = facts["python3"]
    base = remote_base(args, facts)
    rc, _, _ = ssh(args, "test -x %s" % shlex.quote(base + "/bin/vps-supervisor"), check=False)
    if rc != 0:
        die("vps-supervisor is not installed on %s (looked in %s); run install or deploy first"
            % (args.target, base))
    return base


def cmd_detect(args):
    base = locate_agent(args)
    _, out, _ = ssh(args, remote_agent(args, base, "detect"))
    if args.json:
        print(out, end="")
    else:
        print_summary(json.loads(out))


def cmd_status(args):
    base = locate_agent(args)
    _, out, _ = ssh(args, remote_agent(args, base, "status"))
    if args.json:
        print(out, end="")
        return
    cfg = json.loads(out)
    print("  version     : %s (installed %s)" % (cfg.get("version"), cfg.get("installed_at")))
    print("  base        : %s" % cfg.get("base"))
    print_summary(cfg)
    print("  apps        : %s" % (", ".join(
        "%s (%s, %s)" % (a, i.get("domain") or "-", i.get("release")) for a, i in cfg.get("apps", {}).items())
        or "none"))


def cmd_uninstall(args):
    base = locate_agent(args)
    if not args.yes:
        answer = input("Remove %s on %s (app state included; containers keep running)? [y/N] "
                       % (base, args.target))
        if answer.strip().lower() not in ("y", "yes"):
            print("aborted")
            return
    ssh(args, "if [ \"$(readlink %s 2>/dev/null)\" = %s ]; then rm -f %s; fi; rm -rf %s" % (
        GLOBAL_LINK, shlex.quote(base + "/bin/vps-supervisor"), GLOBAL_LINK, shlex.quote(base)))
    print("==> removed vps-supervisor from %s" % args.target)


def host_args(spec, prefix=None):
    h = spec["host"]
    return argparse.Namespace(target=h["ssh"], port=h.get("port"), identity=h.get("identity"),
                              ssh_option=h.get("ssh_options") or [], prefix=prefix or h.get("prefix"))


def cmd_deploy(args):
    total = 7

    def stage(n, msg):
        print("==> [%d/%d] %s" % (n, total, msg), flush=True)

    stage(1, "reading %s" % args.file)
    spec = load_spec(args.file)
    src = ("build %s" % os.path.relpath(spec["build"]["context"])) if spec["build"] else "image " + spec["image"]
    print("    app %s, %s, port %d, domain %s" % (spec["app"], src, spec["port"], spec["domain"] or "-"))
    h = host_args(spec)

    stage(2, "connecting to %s" % h.target)
    facts = ensure_python(h)
    print("    user %s, %s %s, python %s" % (facts.get("user"), facts.get("os", "?"),
                                             facts.get("arch", "?"), facts.get("python_version")))

    stage(3, "provisioning agent")
    base, cfg = ensure_agent(h, facts)
    if not cfg["detection"]["docker"]["installed"]:
        print("    docker missing: provisioning")
        rc, _ = ssh_stream(h, remote_agent(h, base, "provision"))
        if rc != 0:
            die("provisioning failed")
        base, cfg = ensure_agent(h, facts)
    if not cfg["detection"]["docker"]["accessible"]:
        die("docker is installed but not usable by %s (add the user to the docker group or use root)"
            % facts.get("user"))
    print("    docker %s" % cfg["detection"]["docker"]["version"])

    stage(4, "proxy integration")
    proxy = resolve_proxy(cfg, spec)
    print("    mode %s: %s" % (proxy["mode"], proxy.get("reason")))
    for k in ("network", "entrypoint", "http_entrypoint", "certresolver"):
        if proxy["params"].get(k):
            print("    %-15s %s" % (k, proxy["params"][k]))

    stage(5, "DNS")
    dns_ok = False
    if not spec["domain"]:
        print("    no domain: skipped")
    else:
        host_ips = set(cfg["detection"].get("addresses") or []) | ssh_target_ips(h)
        found, problems = check_dns(spec["domain"], host_ips)
        if problems and not args.skip_dns:
            die("DNS check failed:\n  - " + "\n  - ".join(problems) + "\n(use --skip-dns to deploy anyway)")
        for p in problems:
            print("    warning: %s (ignored: --skip-dns)" % p)
        if not problems:
            dns_ok = True
            print("    %s -> %s ok" % (spec["domain"], ", ".join(sorted(found))))

    if args.check:
        print("==> all checks passed, nothing deployed (--check)")
        return

    stage(6, "deploying")
    payload = dict(spec, proxy=proxy)
    payload.pop("host")
    appdir = "%s/apps/%s" % (base, spec["app"])
    if spec["build"]:
        tarball = pack_context(spec["build"]["context"])
        print("    uploading build context (%d KiB)" % (len(tarball) // 1024 + 1))
        ssh(h, "mkdir -p %s && cat > %s/incoming.tar" % (shlex.quote(appdir), shlex.quote(appdir)), tarball)
        payload["build"] = {"dockerfile": spec["build"]["dockerfile"]}
    rc, result = ssh_stream(h, remote_agent(h, base, "deploy"), json.dumps(payload).encode())
    if rc != 0 or not result:
        die("deploy failed")

    stage(7, "verifying")
    if proxy["mode"] == "traefik-docker":
        if dns_ok:
            ok, detail = verify_https("https://%s%s" % (spec["domain"], spec["healthcheck"]))
            if not ok:
                die("app is running on the host but not reachable from here: %s" % detail)
            print("    %s" % detail)
        else:
            print("    skipped public check (DNS not ready); Traefik will request the certificate "
                  "once %s points here (redeploy to retrigger)" % spec["domain"])
        url = "https://%s" % spec["domain"]
    else:
        url = "http://127.0.0.1:%s on the host (no proxy configured)" % result["host_port"]
    print("==> %s release %s deployed: %s" % (spec["app"], result["release"], url))


def cmd_destroy(args):
    spec = load_spec(args.file)
    h = host_args(spec)
    if not args.yes:
        answer = input("Destroy app %s on %s (container, images, state)? [y/N] " % (spec["app"], h.target))
        if answer.strip().lower() not in ("y", "yes"):
            print("aborted")
            return
    base = locate_agent(h)
    rc, _ = ssh_stream(h, remote_agent(h, base, "destroy " + shlex.quote(spec["app"])))
    sys.exit(rc)


def cmd_logs(args):
    spec = load_spec(args.file)
    h = host_args(spec)
    base = locate_agent(h)
    rc, _ = ssh_stream(h, remote_agent(h, base, "logs %s -n %d" % (shlex.quote(spec["app"]), args.lines)))
    sys.exit(rc)


