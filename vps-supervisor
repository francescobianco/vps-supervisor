def build_parser():
    parser = argparse.ArgumentParser(prog="vps-supervisor", description=__doc__.split("\n")[0])
    parser.add_argument("--version", action="version", version=VERSION)
    sub = parser.add_subparsers(dest="command")
    sub.required = True

    p = sub.add_parser("deploy", help="check, provision and deploy an app from its deployment file")
    p.add_argument("file", help="deployment file (YAML, any name)")
    p.add_argument("--check", action="store_true", help="run all checks, deploy nothing")
    p.add_argument("--skip-dns", action="store_true", help="deploy even if the domain does not point here")
    p.set_defaults(func=cmd_deploy)

    p = sub.add_parser("destroy", help="remove the app described by a deployment file")
    p.add_argument("file")
    p.add_argument("-y", "--yes", action="store_true")
    p.set_defaults(func=cmd_destroy)

    p = sub.add_parser("logs", help="show container logs of the app in a deployment file")
    p.add_argument("file")
    p.add_argument("-n", "--lines", type=int, default=100)
    p.set_defaults(func=cmd_logs)

    def remote(name, func, help_):
        p = sub.add_parser(name, help=help_)
        p.add_argument("target", help="ssh destination, e.g. root@1.2.3.4 or a Host from ~/.ssh/config")
        p.add_argument("-p", "--port", type=int, help="ssh port")
        p.add_argument("-i", "--identity", help="ssh private key")
        p.add_argument("-o", "--ssh-option", action="append", help="extra ssh -o option (repeatable)")
        p.add_argument("--prefix", help="install dir on host (default: %s for root, %s otherwise)"
                       % (ROOT_BASE, USER_BASE))
        p.set_defaults(func=func)
        return p

    remote("install", cmd_install, "install/upgrade the agent on a host over ssh")
    remote("detect", cmd_detect, "re-run web stack detection on a host").add_argument(
        "--json", action="store_true")
    remote("status", cmd_status, "show agent config and apps on a host").add_argument(
        "--json", action="store_true")
    remote("uninstall", cmd_uninstall, "remove the agent from a host").add_argument(
        "-y", "--yes", action="store_true", help="do not ask for confirmation")

    agent = sub.add_parser("agent", help="commands executed on the host by the agent")
    asub = agent.add_subparsers(dest="agent_command")
    asub.required = True
    for name, func in (("init", cmd_agent_init), ("detect", cmd_agent_detect),
                       ("status", cmd_agent_status), ("version", cmd_agent_version),
                       ("provision", cmd_agent_provision), ("deploy", cmd_agent_deploy),
                       ("destroy", cmd_agent_destroy), ("logs", cmd_agent_logs)):
        p = asub.add_parser(name)
        p.add_argument("--base", help="agent home directory")
        if name in ("destroy", "logs"):
            p.add_argument("app")
        if name == "logs":
            p.add_argument("-n", "--lines", type=int, default=100)
        p.set_defaults(func=func)
    return parser


def main(argv=None):
    if sys.version_info < MIN_PYTHON:
        die("python >= %d.%d required" % MIN_PYTHON)
    args = build_parser().parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
