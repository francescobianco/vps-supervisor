#!/usr/bin/env python3
"""vps-supervisor - a tiny Heroku/Piku-like deployer that adapts to the host.

Unlike Piku, it does not take ownership of ports 80/443, and an app is fully
described by ONE deployment file (any name): host, domain, build, env, ...

The same file works as two things:

  * local CLI   : `vps-supervisor deploy app.yml` checks everything (ssh, agent,
                  docker, proxy, DNS), provisions the host if needed, uploads
                  the app and verifies it is reachable.
  * remote agent: `vps-supervisor agent <cmd>` runs on the host, classifies the
                  existing web stack (nginx, caddy, traefik, docker, ...) and
                  plugs containers into it.

Only the Python standard library is required (Python >= 3.8 on both sides);
PyYAML is used locally when available, otherwise a built-in YAML subset parser.
"""

import argparse
import datetime
import hashlib
import io
import ipaddress
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.request

VERSION = "0.2.0"
MIN_PYTHON = (3, 8)
WEB_PORTS = (80, 443)
ROOT_BASE = "/opt/vps-supervisor"
USER_BASE = "~/.vps-supervisor"
GLOBAL_LINK = "/usr/local/bin/vps-supervisor"
KEEP_RELEASES = 3
DEPLOYABLE_MODES = ("traefik-docker", "none", "manual")
# docker: app runs in an isolated container; host: app runs on the machine (planned, e.g. systemd unit)
RUNTIMES = ("docker", "host")

# Shell probe executed on the remote host before anything is uploaded.
# Prints key=value lines; must work with a plain POSIX sh.
REMOTE_PROBE = r"""
echo "uid=$(id -u)"
echo "user=$(id -un)"
echo "home=$HOME"
if command -v python3 >/dev/null 2>&1; then
  echo "python3=$(command -v python3)"
  echo "python_version=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
fi
if command -v docker >/dev/null 2>&1; then echo "docker=$(command -v docker)"; fi
if command -v apt-get >/dev/null 2>&1; then echo "apt=1"; fi
if sudo -n true >/dev/null 2>&1; then echo "sudo=1"; else echo "sudo=0"; fi
if [ -r /etc/os-release ]; then . /etc/os-release; echo "os=${ID:-unknown} ${VERSION_ID:-}"; fi
echo "arch=$(uname -m)"
"""


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------

def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()


def run(cmd, timeout=15):
    """Run a command, never raise: return (returncode, stdout+stderr)."""
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=timeout, universal_newlines=True)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, str(e)


def die(msg, code=1):
    print("error: " + msg, file=sys.stderr, flush=True)
    sys.exit(code)


def tail(text, n=30):
    return "\n".join(text.rstrip().splitlines()[-n:])


def is_root():
    return os.geteuid() == 0


def can_sudo():
    return not is_root() and shutil.which("sudo") is not None and run(["sudo", "-n", "true"])[0] == 0


def priv(cmd):
    """Prefix with `sudo -n` when not root and sudo is passwordless."""
    return cmd if is_root() or not can_sudo() else ["sudo", "-n"] + cmd


def write_private(path, text):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {} if default is None else default


def norm_ip(addr):
    try:
        return str(ipaddress.ip_address(addr.split("%")[0]))
    except ValueError:
        return None


# --------------------------------------------------------------------------
# agent: detection / classification of the existing web stack
# --------------------------------------------------------------------------

def listeners_ss():
    """Return {port: set(process names)} for web ports using `ss`, or None."""
    if not shutil.which("ss"):
        return None
    rc, out = run(priv(["ss", "-ltnpH"]))
    if rc != 0:
        rc, out = run(["ss", "-ltnH"])
        if rc != 0:
            return None
    result = {}
    for line in out.splitlines():
        fields = line.split()
        if len(fields) < 4:
            continue
        try:
            port = int(fields[3].rsplit(":", 1)[1])
        except (IndexError, ValueError):
            continue
        if port in WEB_PORTS:
            result.setdefault(port, set()).update(re.findall(r'\("([^"]+)",pid=', line))
    return result


def listeners_proc():
    """Fallback without `ss`: parse /proc/net/tcp{,6} (no process names)."""
    result = {}
    for path in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(path) as f:
                next(f)
                for line in f:
                    parts = line.split()
                    if len(parts) > 3 and parts[3] == "0A":  # LISTEN
                        port = int(parts[1].rsplit(":", 1)[1], 16)
                        if port in WEB_PORTS:
                            result.setdefault(port, set())
        except OSError:
            pass
    return result


def host_addresses():
    """Public-facing addresses of the host (docker/bridge interfaces excluded)."""
    rc, out = run(["ip", "-o", "addr", "show", "scope", "global"])
    addrs = []
    if rc == 0:
        for line in out.splitlines():
            f = line.split()
            if len(f) < 4 or f[1].startswith(("docker", "br-", "veth", "virbr", "cni", "flannel", "cali")):
                continue
            ip = norm_ip(f[3].split("/")[0])
            if ip:
                addrs.append(ip)
    return addrs


def traefik_params(docker_cmd, container, port_map):
    """Read a dockerised Traefik's static config from its CLI args."""
    rc, out = run(docker_cmd + ["inspect", "--format", "{{json .Args}}", container])
    args = json.loads(out) if rc == 0 and out.strip() else []
    rc, out = run(docker_cmd + ["inspect", "--format", "{{json .NetworkSettings.Networks}}", container])
    networks = sorted(json.loads(out)) if rc == 0 and out.strip() else []

    entrypoints, resolvers, config_files = {}, [], []
    network, exposed = None, True
    for a in args or []:
        if not a.startswith("--"):
            continue
        key, _, val = a[2:].partition("=")
        low = key.lower()
        if low == "providers.docker.network":
            network = val
        elif low == "providers.docker.exposedbydefault":
            exposed = val.lower() != "false"
        elif low == "configfile":
            config_files.append(val)
        m = re.match(r"entrypoints\.([^.]+)\.address$", key, re.I)
        if m:
            port = val.rsplit(":", 1)[-1].split("/")[0]
            if port.isdigit():
                entrypoints[m.group(1)] = int(port)
        m = re.match(r"certificatesresolvers\.([^.]+)\.", key, re.I)
        if m and m.group(1) not in resolvers:
            resolvers.append(m.group(1))

    # entrypoint whose container port is published on host 443 / 80
    by_container_port = {cp: hp for hp, cp in port_map.items()}
    https_ep = next((n for n, p in entrypoints.items() if by_container_port.get(p) == 443), None)
    http_ep = next((n for n, p in entrypoints.items() if by_container_port.get(p) == 80), None)
    if network is None and len(networks) == 1:
        network = networks[0]
    return {
        "network": network,
        "entrypoint": https_ep,
        "http_entrypoint": http_ep,
        "certresolver": resolvers[0] if resolvers else None,
        "certresolvers": resolvers,
        "exposed_by_default": exposed,
        "entrypoints": entrypoints,
        "networks": networks,
        "config_files": config_files,
        "complete": bool(network and https_ep),
    }


def detect_docker():
    info = {"installed": shutil.which("docker") is not None, "accessible": False,
            "version": None, "command": None, "web_containers": []}
    if not info["installed"]:
        return info
    for cmd in (["docker"], ["sudo", "-n", "docker"]):
        if cmd[0] == "sudo" and not can_sudo():
            continue
        rc, out = run(cmd + ["info", "--format", "{{.ServerVersion}}"])
        if rc == 0:
            info.update(accessible=True, version=out.strip(), command=cmd)
            break
    if info["accessible"]:
        rc, out = run(info["command"] + ["ps", "--format", "{{.Names}}\t{{.Image}}\t{{.Ports}}"])
        if rc == 0:
            for line in out.splitlines():
                name, image, ports = (line.split("\t") + ["", ""])[:3]
                port_map = {}
                for hp, cp in re.findall(r":(\d+)->(\d+)/tcp", ports):
                    if int(hp) in WEB_PORTS:
                        port_map[int(hp)] = int(cp)
                if port_map:
                    c = {"name": name, "image": image, "ports": sorted(port_map), "port_map": port_map}
                    if "traefik" in image.lower():
                        c["traefik"] = traefik_params(info["command"], name, port_map)
                    info["web_containers"].append(c)
    return info


def first_existing(paths):
    for p in paths:
        if os.path.exists(p):
            return p
    return None


def decide_proxy(ports, docker):
    """Classify who owns 80/443 and how apps can be plugged in."""
    owners = set()
    for names in ports.values():
        owners |= set(names)
    busy = [p for p in WEB_PORTS if p in ports]

    def writable(path):
        return bool(path) and (os.access(path, os.W_OK) or is_root() or can_sudo())

    if "nginx" in owners:
        d = first_existing(["/etc/nginx/conf.d", "/etc/nginx/sites-enabled", "/etc/nginx/http.d"])
        return {"mode": "nginx", "params": {"config_dir": d, "writable": writable(d)},
                "reason": "nginx is listening on %s" % busy}
    if "caddy" in owners:
        f = first_existing(["/etc/caddy/Caddyfile"])
        return {"mode": "caddy", "params": {"config_file": f, "writable": writable(f)},
                "reason": "caddy is listening on %s" % busy}
    if owners & {"apache2", "httpd"}:
        d = first_existing(["/etc/apache2/sites-enabled", "/etc/httpd/conf.d"])
        return {"mode": "apache", "params": {"config_dir": d, "writable": writable(d)},
                "reason": "apache is listening on %s" % busy}
    if "haproxy" in owners:
        return {"mode": "haproxy", "params": {"config_file": first_existing(["/etc/haproxy/haproxy.cfg"])},
                "reason": "haproxy is listening on %s" % busy}
    if "traefik" in owners:
        return {"mode": "traefik", "params": {}, "reason": "traefik (native) is listening on %s" % busy}
    if docker["web_containers"]:
        c = next((x for x in docker["web_containers"] if "traefik" in x), docker["web_containers"][0])
        image = c["image"].lower()
        if "traefik" in c:
            p = c["traefik"]
            return {"mode": "traefik-docker", "container": c["name"], "image": c["image"], "params": p,
                    "reason": "traefik container %s publishes %s (network=%s, entrypoint=%s, certresolver=%s)"
                              % (c["name"], c["ports"], p["network"], p["entrypoint"], p["certresolver"])}
        mode = "docker-container"
        for key, m in (("caddy", "caddy-docker"), ("nginx-proxy", "nginx-proxy-docker"),
                       ("nginx-proxy-manager", "npm-docker")):
            if key in image:
                mode = m
        return {"mode": mode, "container": c["name"], "image": c["image"], "params": {},
                "reason": "container %s (%s) publishes %s" % (c["name"], c["image"], c["ports"])}
    if not busy:
        return {"mode": "none", "params": {},
                "reason": "ports 80/443 are free: apps are exposed on 127.0.0.1 until a proxy is chosen"}
    return {"mode": "manual", "params": {},
            "reason": "ports %s are busy but the owner is unknown (needs root/sudo to identify); "
                      "apps are exposed on 127.0.0.1 only" % busy}


def detect():
    ports = listeners_ss()
    method = "ss"
    if ports is None:
        ports, method = listeners_proc(), "/proc/net/tcp"
    binaries = {b: shutil.which(b) for b in
                ("nginx", "caddy", "apache2", "httpd", "haproxy", "traefik", "git", "systemctl")}
    docker = detect_docker()
    return {
        "detected_at": now_iso(),
        "user": os.environ.get("USER") or str(os.geteuid()),
        "root": is_root(),
        "sudo": can_sudo(),
        "addresses": host_addresses(),
        "ports": {str(p): {"listening": p in ports, "processes": sorted(ports.get(p, []))}
                  for p in WEB_PORTS},
        "ports_method": method,
        "binaries": {k: v for k, v in binaries.items() if v},
        "docker": docker,
        "proxy": decide_proxy(ports, docker),
    }


# --------------------------------------------------------------------------
# agent commands (run on the host)
# --------------------------------------------------------------------------

def agent_base(args):
    return os.path.expanduser(args.base or os.environ.get("VPS_SUPERVISOR_HOME")
                              or (ROOT_BASE if is_root() else USER_BASE))


def config_path(base):
    return os.path.join(base, "config.json")


def cmd_agent_init(args):
    base = agent_base(args)
    for sub in ("bin", "apps", "logs", "state"):
        os.makedirs(os.path.join(base, sub), exist_ok=True)
    cfg = read_json(config_path(base))
    det = detect()
    cfg.update({
        "version": VERSION,
        "base": base,
        "installed_at": cfg.get("installed_at") or now_iso(),
        "updated_at": now_iso(),
        "proxy": det["proxy"],
        "docker_command": det["docker"]["command"],
        "detection": det,
    })
    write_private(config_path(base), json.dumps(cfg, indent=2))
    if is_root():
        me = os.path.join(base, "bin", "vps-supervisor")
        try:
            if os.path.islink(GLOBAL_LINK) or not os.path.exists(GLOBAL_LINK):
                if os.path.islink(GLOBAL_LINK):
                    os.unlink(GLOBAL_LINK)
                os.symlink(me, GLOBAL_LINK)
        except OSError:
            pass
    print(json.dumps(cfg, indent=2))


def cmd_agent_detect(args):
    print(json.dumps(detect(), indent=2))


def cmd_agent_status(args):
    base = agent_base(args)
    cfg = read_json(config_path(base))
    if not cfg:
        die("agent not initialised in %s" % base)
    apps = {}
    appsdir = os.path.join(base, "apps")
    for app in sorted(os.listdir(appsdir)) if os.path.isdir(appsdir) else []:
        cur = read_json(os.path.join(appsdir, app, "state.json")).get("current")
        if cur:
            apps[app] = {k: cur.get(k) for k in ("release", "image", "domain", "deployed_at")}
    cfg["apps"] = apps
    print(json.dumps(cfg, indent=2))


def cmd_agent_version(args):
    print(VERSION)


def cmd_agent_provision(args):
    """Install host prerequisites (currently: docker) on apt-based systems."""
    if shutil.which("docker"):
        print("docker already installed")
        return
    if not is_root():
        die("installing docker requires root")
    if not shutil.which("apt-get"):
        die("automatic docker install is only supported on apt-based systems; install docker manually")
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    for cmd in (["apt-get", "update", "-qq"], ["apt-get", "install", "-y", "-qq", "docker.io"]):
        print("    $ " + " ".join(cmd), flush=True)
        if subprocess.call(cmd, env=env) != 0:
            die("command failed: " + " ".join(cmd))
    run(["systemctl", "enable", "--now", "docker"], timeout=60)
    print("docker installed")


def safe_extract(tar, dest):
    if hasattr(tarfile, "data_filter"):
        tar.extractall(dest, filter="data")
        return
    root = os.path.realpath(dest)
    for m in tar.getmembers():
        target = os.path.realpath(os.path.join(dest, m.name))
        if m.isdev() or not (target == root or target.startswith(root + os.sep)):
            die("unsafe path in upload: %s" % m.name)
        if m.issym() or m.islnk():
            link = os.path.realpath(os.path.join(os.path.dirname(target), m.linkname))
            if not link.startswith(root + os.sep):
                die("unsafe link in upload: %s -> %s" % (m.name, m.linkname))
    tar.extractall(dest)


def free_port(start=20000, end=29999, taken=()):
    for port in range(start, end):
        if port in taken:
            continue
        with socket.socket() as s:
            try:
                s.bind(("127.0.0.1", port))
                return port
            except OSError:
                continue
    die("no free port in %d-%d" % (start, end))


def wait_healthy(docker, name, url_of, timeout=60):
    deadline = time.time() + timeout
    last = "no answer"
    while time.time() < deadline:
        _, st = run(docker + ["inspect", "-f", "{{.State.Status}}", name])
        st = st.strip()
        if st in ("exited", "dead"):
            return False, "container %s" % st
        url = url_of()
        if url:
            try:
                with urllib.request.urlopen(url, timeout=3) as r:
                    return True, "%s -> %d" % (url, r.status)
            except urllib.error.HTTPError as e:
                if e.code < 500:
                    return True, "%s -> %d" % (url, e.code)
                last = "%s -> %d" % (url, e.code)
            except Exception as e:  # connection refused, timeout, ...
                last = "%s: %s" % (url, e)
        time.sleep(1)
    return False, "timeout after %ds (%s)" % (timeout, last)


def cmd_agent_deploy(args):
    """Deploy an app; the resolved spec comes as JSON on stdin."""
    base = agent_base(args)
    cfg = read_json(config_path(base))
    docker = cfg.get("docker_command") or die("docker is not accessible on this host")
    spec = json.load(sys.stdin)
    app, proxy = spec["app"], spec["proxy"]
    name = "vps-" + app
    appdir = os.path.join(base, "apps", app)
    os.makedirs(appdir, exist_ok=True)
    state_file = os.path.join(appdir, "state.json")
    state = read_json(state_file)
    release = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d%H%M%S")

    def step(msg):
        print("    " + msg, flush=True)

    def dk(*a, check=True, timeout=1800):
        rc, out = run(docker + list(a), timeout=timeout)
        if check and rc != 0:
            die("docker %s failed:\n%s" % (a[0], tail(out)))
        return out

    # 1. image
    if spec.get("build"):
        rel = os.path.join(appdir, "releases", release)
        os.makedirs(rel)
        upload = os.path.join(appdir, "incoming.tar")
        with tarfile.open(upload) as t:
            safe_extract(t, rel)
        os.remove(upload)
        image = "%s:%s" % (name, release)
        step("building image %s" % image)
        dk("build", "-t", image, "-f", os.path.join(rel, spec["build"]["dockerfile"]), rel)
    else:
        image = spec["image"]
        step("pulling image %s" % image)
        dk("pull", image)

    # 2. container definition
    env_file = os.path.join(appdir, "env")
    write_private(env_file, "".join("%s=%s\n" % kv for kv in sorted(spec["env"].items())))
    labels = {"vps-supervisor.app": app, "vps-supervisor.release": release}
    runargs = ["run", "-d", "--name", name, "--restart", "unless-stopped", "--env-file", env_file]
    mode, params = proxy["mode"], proxy["params"]
    if mode == "traefik-docker":
        r, domain, net = name, spec["domain"], params["network"]
        labels.update({
            "vps-supervisor.domain": domain,
            "traefik.enable": "true",
            "traefik.docker.network": net,
            "traefik.http.routers.%s.rule" % r: "Host(`%s`)" % domain,
            "traefik.http.routers.%s.entrypoints" % r: params["entrypoint"],
            "traefik.http.routers.%s.tls" % r: "true",
            "traefik.http.routers.%s.service" % r: r,
            "traefik.http.services.%s.loadbalancer.server.port" % r: str(spec["port"]),
        })
        if params.get("certresolver"):
            labels["traefik.http.routers.%s.tls.certresolver" % r] = params["certresolver"]
        if params.get("http_entrypoint"):
            labels.update({
                "traefik.http.routers.%s-http.rule" % r: "Host(`%s`)" % domain,
                "traefik.http.routers.%s-http.entrypoints" % r: params["http_entrypoint"],
                "traefik.http.routers.%s-http.middlewares" % r: "%s-https" % r,
                "traefik.http.routers.%s-http.service" % r: r,
                "traefik.http.middlewares.%s-https.redirectscheme.scheme" % r: "https",
            })
        runargs += ["--network", net]
        ip_fmt = "{{with index .NetworkSettings.Networks %s}}{{.IPAddress}}{{end}}" % json.dumps(net)

        def url_of():
            ip = dk("inspect", "-f", ip_fmt, name, check=False).strip()
            return "http://%s:%d%s" % (ip, spec["port"], spec["healthcheck"]) if ip else None
    else:
        state["host_port"] = state.get("host_port") or free_port()
        runargs += ["-p", "127.0.0.1:%d:%d" % (state["host_port"], spec["port"])]

        def url_of():
            return "http://127.0.0.1:%d%s" % (state["host_port"], spec["healthcheck"])
    for k, v in sorted(labels.items()):
        runargs += ["--label", "%s=%s" % (k, v)]
    for v in spec["volumes"]:
        runargs += ["-v", v]
    runargs.append(image)

    # 3. swap container, health check, rollback on failure
    previous = state.get("current")
    step("starting container %s" % name)
    dk("rm", "-f", name, check=False)
    dk(*runargs)
    ok, detail = wait_healthy(docker, name, url_of)
    if not ok:
        logs = dk("logs", "--tail", "40", name, check=False)
        dk("rm", "-f", name, check=False)
        if previous:
            step("rolling back to release %s" % previous["release"])
            dk(*previous["run"], check=False)
        die("health check failed: %s\n--- container logs ---\n%s" % (detail, tail(logs, 40)))
    step("healthy: %s" % detail)

    state["current"] = {"release": release, "image": image, "run": runargs,
                        "domain": spec.get("domain"), "deployed_at": now_iso()}
    state["spec"] = spec
    write_private(state_file, json.dumps(state, indent=2))

    # 4. prune old releases
    relroot = os.path.join(appdir, "releases")
    if os.path.isdir(relroot):
        for old in sorted(os.listdir(relroot))[:-KEEP_RELEASES]:
            shutil.rmtree(os.path.join(relroot, old), ignore_errors=True)
            dk("rmi", "%s:%s" % (name, old), check=False)

    print("RESULT " + json.dumps({"release": release, "image": image, "container": name,
                                  "mode": mode, "host_port": state.get("host_port")}), flush=True)


def cmd_agent_destroy(args):
    base = agent_base(args)
    docker = read_json(config_path(base)).get("docker_command") or die("docker is not accessible")
    name = "vps-" + args.app
    run(docker + ["rm", "-f", name], timeout=60)
    _, out = run(docker + ["images", name, "--format", "{{.Repository}}:{{.Tag}}"])
    for img in out.split():
        run(docker + ["rmi", img], timeout=60)
    shutil.rmtree(os.path.join(base, "apps", args.app), ignore_errors=True)
    print("destroyed %s" % args.app)


def cmd_agent_logs(args):
    docker = read_json(config_path(agent_base(args))).get("docker_command") or die("docker is not accessible")
    os.execvp(docker[0], docker + ["logs", "--tail", str(args.lines), "vps-" + args.app])


