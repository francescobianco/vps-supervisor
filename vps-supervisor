def ssh_base(args):
    cmd = shlex.split(os.environ.get("VPS_SUPERVISOR_SSH", "ssh"))
    if args.port:
        cmd += ["-p", str(args.port)]
    if args.identity:
        cmd += ["-i", os.path.expanduser(args.identity)]
    for opt in args.ssh_option or []:
        cmd += ["-o", opt]
    return cmd


def ssh(args, remote, data=None, check=True):
    p = subprocess.run(ssh_base(args) + [args.target, remote], input=data,
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out = p.stdout.decode(errors="replace")
    err = p.stderr.decode(errors="replace")
    if check and p.returncode != 0:
        die("ssh %s failed (exit %d):\n%s%s" % (args.target, p.returncode, out, err))
    return p.returncode, out, err


def ssh_stream(args, remote, data=None):
    """Run remotely, print output live, return (rc, parsed RESULT line)."""
    p = subprocess.Popen(ssh_base(args) + [args.target, remote], stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    p.stdin.write(data or b"")
    p.stdin.close()
    result = None
    for raw in p.stdout:
        line = raw.decode(errors="replace").rstrip("\n")
        if line.startswith("RESULT "):
            result = json.loads(line[7:])
        else:
            print(line, flush=True)
    return p.wait(), result


def ssh_target_ips(args):
    """IPs the ssh target resolves to locally (honours ~/.ssh/config)."""
    hostname = args.target.rsplit("@", 1)[-1]
    rc, out = run(ssh_base(args) + ["-G", args.target])
    if rc == 0:
        for line in out.splitlines():
            if line.startswith("hostname "):
                hostname = line.split(None, 1)[1].strip()
    ips = set()
    try:
        for ai in socket.getaddrinfo(hostname, None):
            ip = norm_ip(ai[4][0])
            if ip:
                ips.add(ip)
    except socket.gaierror:
        pass
    return ips


def probe(args):
    _, out, _ = ssh(args, "sh -s", REMOTE_PROBE.encode())
    facts = {}
    for line in out.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            facts[k.strip()] = v.strip()
    return facts


def ensure_python(args):
    facts = probe(args)
    if "python3" not in facts:
        if facts.get("uid") == "0" and facts.get("apt"):
            print("    python3 missing: installing it with apt-get")
            ssh(args, "DEBIAN_FRONTEND=noninteractive apt-get update -qq && "
                      "DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3")
            facts = probe(args)
        if "python3" not in facts:
            die("python3 not found on %s; install it first" % args.target)
    try:
        pyver = tuple(int(x) for x in facts.get("python_version", "0.0").split("."))
    except ValueError:
        pyver = (0, 0)
    if pyver < MIN_PYTHON:
        die("python %s on host is too old, need >= %d.%d" % ((facts.get("python_version"),) + MIN_PYTHON))
    args.python = facts["python3"]
    return facts


def remote_base(args, facts):
    if args.prefix:
        return args.prefix
    if facts.get("uid") == "0":
        return ROOT_BASE
    return facts.get("home", "~").rstrip("/") + "/.vps-supervisor"


def remote_agent(args, base, sub):
    return "%s %s agent %s --base %s" % (
        shlex.quote(args.python), shlex.quote(base + "/bin/vps-supervisor"), sub, shlex.quote(base))


def ensure_agent(args, facts):
    """Upload the agent if missing/outdated, refresh detection, return (base, cfg)."""
    base = remote_base(args, facts)
    dest = base + "/bin/vps-supervisor"
    with open(os.path.realpath(__file__), "rb") as f:
        payload = f.read()
    digest = hashlib.sha256(payload).hexdigest()
    _, out, _ = ssh(args, "sha256sum %s 2>/dev/null || true" % shlex.quote(dest))
    if out.split()[:1] != [digest]:
        print("    uploading agent %s to %s" % (VERSION, dest))
        q = shlex.quote
        ssh(args, "mkdir -p %s && cat > %s.new && chmod 755 %s.new && mv %s.new %s" % (
            q(base + "/bin"), q(dest), q(dest), q(dest), q(dest)), payload)
    else:
        print("    agent %s already up to date in %s" % (VERSION, base))
    _, out, _ = ssh(args, remote_agent(args, base, "init"))
    try:
        cfg = json.loads(out)
    except ValueError:
        die("unexpected output from agent init:\n" + out)
    return base, cfg


def print_summary(cfg):
    det = cfg.get("detection", cfg)
    proxy = cfg.get("proxy") or det.get("proxy", {})
    docker = det.get("docker", {})
    print("  user        : %s%s" % (det.get("user"), " (root)" if det.get("root") else
                                    (" (sudo)" if det.get("sudo") else "")))
    if det.get("addresses"):
        print("  addresses   : %s" % ", ".join(det["addresses"]))
    for p, info in sorted(det.get("ports", {}).items(), key=lambda kv: int(kv[0])):
        state = "busy " + (",".join(info["processes"]) or "(unknown owner)") if info["listening"] else "free"
        print("  port %-6s : %s" % (p, state))
    if docker.get("accessible"):
        print("  docker      : %s (%s)" % (docker.get("version"), " ".join(docker.get("command") or [])))
    elif docker.get("installed"):
        print("  docker      : installed but NOT accessible for this user")
    else:
        print("  docker      : not installed")
    print("  proxy mode  : %s" % proxy.get("mode"))
    print("                %s" % proxy.get("reason"))
    for k in ("network", "entrypoint", "http_entrypoint", "certresolver", "config_dir", "config_file"):
        v = (proxy.get("params") or {}).get(k)
        if v:
            print("    %-15s %s" % (k, v))


